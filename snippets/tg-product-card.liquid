{%- comment -%}
  Toggi Toys — product card (clean, centered, discount % + sold-out badges)
  Usage:
    {% render 'tg-product-card', product: product %}
    {% render 'tg-product-card', placeholder_index: 1 %}   (no product → placeholder card)
  Optional:
    show_secondary_image (boolean)
    show_swatches        (boolean — lists Color/Colour option values)
    show_description     (boolean — custom.short_description metafield, else description excerpt)
    show_rating          (boolean — stars from Shopify's reviews.rating / reviews.rating_count metafields)
    show_empty_rating    (boolean — grey stars for products without reviews yet)
    show_quick_view      (boolean — eye icon opens the quick view, needs tg-product-card.js)
    show_add_to_cart     (boolean — cart icon on the image)
    show_buy_now         (boolean — "Buy now" button → straight to checkout)
    buy_now_label        (string)
    id_prefix            (string — keeps form IDs unique when a product appears twice on a page)
  Products with one variant add to cart / buy directly. Products with options open the quick
  view so the shopper can choose first (links to the product page if JavaScript is off).
{%- endcomment -%}
{%- if product != blank -%}
  {%- liquid
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
      assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    endif
    assign image = product.featured_media.preview_image
    assign second_image = product.media[1].preview_image
    assign image_alt = image.alt | default: product.title
    assign price_min = product.price_min | money

    assign single_variant = false
    if product.has_only_default_variant or product.variants.size == 1
      assign single_variant = true
    endif
    assign variant = product.selected_or_first_available_variant
    assign form_id = 'TgCardForm-' | append: id_prefix | append: '-' | append: product.id
    assign buy_label = buy_now_label | default: 'Buy now'

    if show_description
      assign short_description = product.metafields.custom.short_description.value
      if short_description == blank
        assign short_description = product.description | strip_html | strip_newlines | truncatewords: 14, '…'
      endif
    endif
  -%}
  <div class="tg-card{% if product.available == false %} tg-card--sold-out{% endif %}">
    <a href="{{ product.url }}" class="tg-card__link" aria-label="{{ product.title | escape }}"></a>

    <div class="tg-card__media{% if show_secondary_image and second_image %} tg-card__media--hover{% endif %}">
      {%- if image -%}
        {{
          image
          | image_url: width: 600
          | image_tag:
            widths: '250, 360, 480, 600',
            sizes: '(min-width: 990px) 280px, (min-width: 750px) 33vw, 50vw',
            loading: 'lazy',
            class: 'tg-card__img',
            alt: image_alt
        }}
        {%- if show_secondary_image and second_image -%}
          {{
            second_image
            | image_url: width: 600
            | image_tag:
              widths: '250, 360, 480, 600',
              sizes: '(min-width: 990px) 280px, (min-width: 750px) 33vw, 50vw',
              loading: 'lazy',
              class: 'tg-card__img tg-card__img--second',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      <div class="tg-card__badges">
        {%- if on_sale -%}
          <span class="tg-card__badge tg-card__badge--sale">-{{ discount }}%</span>
        {%- endif -%}
        {%- if product.available == false -%}
          <span class="tg-card__badge tg-card__badge--sold">{{ 'products.product.sold_out' | t }}</span>
        {%- endif -%}
      </div>

      {%- if show_quick_view or show_add_to_cart -%}
        <div class="tg-card__actions">
          {%- if show_quick_view -%}
            <a
              href="{{ product.url }}"
              class="tg-card__icon"
              data-tg-quick-view="{{ product.handle }}"
              aria-label="Quick view: {{ product.title | escape }}"
              title="Quick view"
            >
              {%- render 'tg-icon', icon: 'eye' -%}
            </a>
          {%- endif -%}
          {%- if show_add_to_cart and product.available -%}
            {%- if single_variant -%}
              <button
                type="submit"
                form="{{ form_id }}"
                class="tg-card__icon"
                aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}"
                title="{{ 'products.product.add_to_cart' | t }}"
              >
                {%- render 'tg-icon', icon: 'cart' -%}
              </button>
            {%- else -%}
              <a
                href="{{ product.url }}"
                class="tg-card__icon"
                data-tg-quick-view="{{ product.handle }}"
                aria-label="{{ 'products.product.choose_options' | t }}: {{ product.title | escape }}"
                title="{{ 'products.product.choose_options' | t }}"
              >
                {%- render 'tg-icon', icon: 'cart' -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="tg-card__info">
      {%- if show_swatches -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- if option_name contains 'color' or option_name contains 'colour' -%}
            <ul class="tg-card__swatches" aria-label="{{ option.name | escape }}">
              {%- for value in option.values limit: 4 -%}
                <li>{{ value | escape }}</li>
              {%- endfor -%}
              {%- if option.values.size > 4 -%}
                <li>+{{ option.values.size | minus: 4 }}</li>
              {%- endif -%}
            </ul>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <h3 class="tg-card__title">{{ product.title | escape }}</h3>
      {%- if show_rating -%}
        {%- comment -%}
          Shopify's standard review metafields (filled by review apps: Judge.me, Shopify Product Reviews, etc.)
        {%- endcomment -%}
        {%- liquid
          assign rating = product.metafields.reviews.rating.value
          assign rating_value = 0
          assign rating_max = 5
          assign rating_count = 0
          if rating != blank
            assign rating_value = rating.rating | times: 1.0
            assign rating_max = rating.scale_max | times: 1.0
            assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
          endif
          assign rating_pct = rating_value | divided_by: rating_max | times: 100 | round: 1
        -%}
        {%- if rating_value > 0 or show_empty_rating -%}
          <div class="tg-card__rating{% if rating_value == 0 %} tg-card__rating--empty{% endif %}">
            <span class="tg-stars" style="--tg-rating: {{ rating_pct }}%;" aria-hidden="true"></span>
            {%- if rating_count > 0 -%}
              <span class="tg-card__rating-count" aria-hidden="true">({{ rating_count }})</span>
            {%- endif -%}
            <span class="visually-hidden">
              {%- if rating_value > 0 -%}
                {{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: rating_max }}, {{ rating_count }} {{ 'accessibility.total_reviews' | t }}
              {%- else -%}
                No reviews yet
              {%- endif -%}
            </span>
          </div>
        {%- endif -%}
      {%- endif -%}
      {%- if show_description and short_description != blank -%}
        <p class="tg-card__desc">{{ short_description | strip_html | escape }}</p>
      {%- endif -%}
      <div class="tg-card__price">
        <span class="tg-card__price-now">
          {%- if product.price_varies -%}
            {{ 'products.product.price.from_price_html' | t: price: price_min }}
          {%- else -%}
            {{ product.price | money }}
          {%- endif -%}
        </span>
        {%- if on_sale -%}
          <s class="tg-card__price-was">
            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
            {{- product.compare_at_price | money -}}
          </s>
        {%- endif -%}
      </div>

      {%- if show_buy_now -%}
        {%- if product.available == false -%}
          <button type="button" class="tg-card__buy" disabled>{{ 'products.product.sold_out' | t }}</button>
        {%- elsif single_variant -%}
          {%- comment -%} Normal form POST with return_to → Shopify adds the item and opens checkout {%- endcomment -%}
          <button type="submit" form="{{ form_id }}" name="return_to" value="/checkout" class="tg-card__buy">
            {%- render 'tg-icon', icon: 'bag' -%}
            {{- buy_label | escape -}}
          </button>
        {%- else -%}
          <a href="{{ product.url }}" class="tg-card__buy" data-tg-quick-view="{{ product.handle }}">
            {%- render 'tg-icon', icon: 'bag' -%}
            {{- buy_label | escape -}}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if single_variant and product.available -%}
      {%- if show_add_to_cart or show_buy_now -%}
        <form id="{{ form_id }}" action="{{ routes.cart_add_url }}" method="post" class="tg-card__form" data-tg-cart-form hidden>
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
        </form>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- else -%}
  {%- comment -%} Placeholder shown in the editor until a collection is chosen {%- endcomment -%}
  {%- assign ph = placeholder_index | default: 1 | modulo: 4 | plus: 1 -%}
  <div class="tg-card tg-card--placeholder">
    <div class="tg-card__media">
      {{ 'product-' | append: ph | placeholder_svg_tag: 'placeholder-svg' }}
      <div class="tg-card__badges">
        <span class="tg-card__badge tg-card__badge--sale">-10%</span>
      </div>
      {%- if show_quick_view or show_add_to_cart -%}
        <div class="tg-card__actions" aria-hidden="true">
          {%- if show_quick_view -%}<span class="tg-card__icon">{% render 'tg-icon', icon: 'eye' %}</span>{%- endif -%}
          {%- if show_add_to_cart -%}<span class="tg-card__icon">{% render 'tg-icon', icon: 'cart' %}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="tg-card__info">
      <h3 class="tg-card__title">Example toy product name</h3>
      {%- if show_rating -%}
        <div class="tg-card__rating" aria-hidden="true">
          <span class="tg-stars" style="--tg-rating: 90%;"></span>
          <span class="tg-card__rating-count">(12)</span>
        </div>
      {%- endif -%}
      {%- if show_description -%}
        <p class="tg-card__desc">A short, friendly description of the toy appears here.</p>
      {%- endif -%}
      <div class="tg-card__price">
        <span class="tg-card__price-now">{{ 45000 | money }}</span>
        <s class="tg-card__price-was">{{ 50000 | money }}</s>
      </div>
      {%- if show_buy_now -%}
        <span class="tg-card__buy" aria-hidden="true">
          {%- render 'tg-icon', icon: 'bag' -%}
          {{- buy_now_label | default: 'Buy now' | escape -}}
        </span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
