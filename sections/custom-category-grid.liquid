{%- comment -%}
  Toggi Toys — Shop by category
  Circle or card tiles. Each block links to a collection (image falls back to the collection's image).
  Mobile: swipeable row. Desktop: grid.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .tg-section {
    --tg-bg: {{ section.settings.bg_color }};
    --tg-heading: {{ section.settings.heading_color }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="tg-section section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="tg-section__header">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="tg-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="tg-subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="tg-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} →</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="tg-scroller tg-categories tg-categories--{{ section.settings.style }}"
      style="--tg-cols: {{ section.settings.columns_desktop }};"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_obj = block.settings.collection
          assign image = block.settings.image | default: collection_obj.featured_image
          assign label = block.settings.label | default: collection_obj.title
          assign url = block.settings.link | default: collection_obj.url
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="tg-category" {% if url != blank %}href="{{ url }}"{% else %}role="link" aria-disabled="true"{% endif %}>
            <span class="tg-category__media" style="--tg-cat-bg: {{ block.settings.bg_color }};">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 400
                  | image_tag:
                    widths: '150, 200, 300, 400',
                    sizes: '(min-width: 750px) 180px, 30vw',
                    loading: 'lazy',
                    alt: label
                }}
              {%- else -%}
                {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="tg-category__label">{{ label | default: 'Category' | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Toggi category grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find the perfect toy for every little explorer"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "default": "/collections"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Tile style",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "card", "label": "Rounded card" }
      ],
      "default": "circle"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#135B33"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Optional. Uses the collection image if empty. Square images work best."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Custom label",
          "info": "Optional. Uses the collection title if empty."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Uses the collection link if empty."
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Tile background",
          "default": "#EFF7F1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Toggi category grid",
      "blocks": [
        { "type": "category", "settings": { "label": "Ride-ons & Vehicles" } },
        { "type": "category", "settings": { "label": "Building Blocks", "bg_color": "#FFF3EA" } },
        { "type": "category", "settings": { "label": "Dolls & Accessories", "bg_color": "#FFF8E8" } },
        { "type": "category", "settings": { "label": "Pretend Play" } },
        { "type": "category", "settings": { "label": "Baby & Toddler", "bg_color": "#FFF3EA" } },
        { "type": "category", "settings": { "label": "Remote Control", "bg_color": "#FFF8E8" } }
      ]
    }
  ]
}
{% endschema %}
