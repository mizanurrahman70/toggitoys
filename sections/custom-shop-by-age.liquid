{%- comment -%}
  Toggi Toys — Shop by age (premium cards)
  Tall gradient cards: big age number + unit, small tag, a toy image rising from the bottom
  and a round arrow button. Swipe row on mobile, grid on desktop.
  Cards without an uploaded image use built-in toy art (assets/tg-hero-*.svg).
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .tg-section {
    --tg-bg: {{ section.settings.bg_color }};
    --tg-heading: {{ section.settings.heading_color }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign default_arts = 'plush,blocks,vehicles,blocks,vehicles' | split: ',' -%}

<div class="tg-section tg-ages-section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="tg-section__header tg-section__header--center">
      {%- if section.settings.heading != blank -%}
        <h2 class="tg-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="tg-subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="tg-scroller tg-ages" style="--tg-cols: {{ section.blocks.size | at_least: 1 }};" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign url = block.settings.link | default: block.settings.collection.url
          assign number = block.settings.number | default: block.settings.label
          assign art = block.settings.default_art
          if art == blank or art == 'auto'
            assign art_index = forloop.index0 | modulo: default_arts.size
            assign art = default_arts[art_index]
          endif
          assign aria = number | append: ' ' | append: block.settings.unit | append: ' ' | append: block.settings.sublabel | strip
          # Built-in photo: "auto" (or no saved value) = photo matching the card's position (1–5)
          assign photo_choice = block.settings.default_photo | default: 'auto'
          if photo_choice == 'auto'
            assign photo_choice = forloop.index0 | modulo: 5 | plus: 1 | append: ''
          endif
          assign use_photo = false
          if block.settings.image == blank and photo_choice != 'none'
            assign use_photo = true
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="tg-age-card{% if use_photo %} tg-age-card--photo{% endif %}"
            {% if url != blank %}href="{{ url }}"{% else %}role="link" aria-disabled="true"{% endif %}
            aria-label="{{ aria | escape }}"
            style="--tg-age-bg: {{ block.settings.bg_color }}; --tg-age-text: {{ block.settings.text_color }};"
          >
            <span class="tg-age-card__top">
              {%- if block.settings.sublabel != blank -%}
                <span class="tg-age-card__tag">
                  {%- if block.settings.icon != 'none' -%}
                    {% render 'tg-icon', icon: block.settings.icon %}
                  {%- endif -%}
                  {{- block.settings.sublabel | escape -}}
                </span>
              {%- endif -%}
              <span class="tg-age-card__num">{{ number | escape }}</span>
              {%- if block.settings.unit != blank -%}
                <span class="tg-age-card__unit">{{ block.settings.unit | escape }}</span>
              {%- endif -%}
            </span>

            {%- if use_photo -%}
              {%- liquid
                assign photo_base = 'tg-age-photo-' | append: photo_choice
                assign photo_420 = photo_base | append: '-tall-420.webp' | asset_url
                assign photo_720 = photo_base | append: '-tall-720.webp' | asset_url
              -%}
              <span class="tg-age-card__photo">
                <img
                  src="{{ photo_420 }}"
                  srcset="{{ photo_420 }} 420w, {{ photo_720 }} 720w"
                  sizes="(min-width: 990px) 20vw, (min-width: 750px) 30vw, 46vw"
                  alt=""
                  width="720"
                  height="960"
                  loading="lazy"
                >
              </span>
            {%- else -%}
            <span class="tg-age-card__art">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    widths: '300, 450, 600',
                    sizes: '(min-width: 990px) 20vw, 45vw',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- elsif art != 'none' -%}
                <img
                  src="{{ 'tg-hero-' | append: art | append: '.svg' | asset_url }}"
                  alt=""
                  width="600"
                  height="500"
                  loading="lazy"
                >
              {%- endif -%}
            </span>
            {%- endif -%}

            <span class="tg-age-card__go" aria-hidden="true">{% render 'tg-icon', icon: 'arrow' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Toggi shop by age",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by age"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The right toy for every stage of growing up"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFAF3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#135B33"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age group",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Big age text",
          "info": "e.g. 0–12 or 3–5 or 8+",
          "default": "0–12"
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit",
          "info": "e.g. Months or Years",
          "default": "Months"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Tag",
          "default": "Baby"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Fallback label",
          "info": "Used only if Big age text is empty (kept for older settings)."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Uses the collection link if empty."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. A transparent PNG of a toy or child works best (about 600 x 500 px)."
        },
        {
          "type": "select",
          "id": "default_photo",
          "label": "Built-in photo",
          "info": "Free Unsplash photos bundled with the theme. Uploading an image above replaces it.",
          "options": [
            { "value": "auto", "label": "Automatic (photo matching this position)" },
            { "value": "none", "label": "None (use artwork below)" },
            { "value": "1", "label": "Baby crib mobile" },
            { "value": "2", "label": "Stacking animal blocks" },
            { "value": "3", "label": "Alphabet puzzle" },
            { "value": "4", "label": "Kid on a bike" },
            { "value": "5", "label": "Board game" }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "default_art",
          "label": "Default artwork (no image)",
          "options": [
            { "value": "auto", "label": "Automatic" },
            { "value": "plush", "label": "Teddy bear" },
            { "value": "blocks", "label": "Building blocks" },
            { "value": "vehicles", "label": "Toy car" },
            { "value": "none", "label": "None" }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Tag icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "baby", "label": "Baby" },
            { "value": "puzzle", "label": "Puzzle" },
            { "value": "star", "label": "Star" },
            { "value": "rocket", "label": "Rocket" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "baby"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card color",
          "default": "#DDF0E3"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Accent color (number, tag, arrow)",
          "default": "#1A7F41"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Toggi shop by age",
      "blocks": [
        { "type": "age" },
        { "type": "age", "settings": { "number": "1–3", "unit": "Years", "sublabel": "Toddler", "icon": "puzzle", "bg_color": "#FFE4D3", "text_color": "#C94F12" } },
        { "type": "age", "settings": { "number": "3–5", "unit": "Years", "sublabel": "Preschool", "icon": "star", "bg_color": "#FFF0C9", "text_color": "#8A5A00" } },
        { "type": "age", "settings": { "number": "5–8", "unit": "Years", "sublabel": "Big kids", "icon": "rocket", "bg_color": "#E6F2D2", "text_color": "#4E7A12" } },
        { "type": "age", "settings": { "number": "8+", "unit": "Years", "sublabel": "Pre-teen", "icon": "gift", "bg_color": "#D7EADF", "text_color": "#135B33" } }
      ]
    }
  ]
}
{% endschema %}
