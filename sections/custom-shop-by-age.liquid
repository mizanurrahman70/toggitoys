{%- comment -%}
  Toggi Toys — Shop by age
  Colourful rounded tiles linking to age collections. Swipe row on mobile, grid on desktop.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .tg-section {
    --tg-bg: {{ section.settings.bg_color }};
    --tg-heading: {{ section.settings.heading_color }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="tg-section section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="tg-section__header tg-section__header--center">
      {%- if section.settings.heading != blank -%}
        <h2 class="tg-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="tg-subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="tg-scroller tg-ages" style="--tg-cols: {{ section.blocks.size | at_least: 1 }};" role="list">
      {%- for block in section.blocks -%}
        {%- assign url = block.settings.link | default: block.settings.collection.url -%}
        <li {{ block.shopify_attributes }}>
          <a
            class="tg-age"
            {% if url != blank %}href="{{ url }}"{% else %}role="link" aria-disabled="true"{% endif %}
            style="--tg-age-bg: {{ block.settings.bg_color }}; --tg-age-text: {{ block.settings.text_color }};"
          >
            {%- if block.settings.icon != 'none' -%}
              <span class="tg-age__icon">{% render 'tg-icon', icon: block.settings.icon %}</span>
            {%- endif -%}
            <span class="tg-age__label">{{ block.settings.label | escape }}</span>
            {%- if block.settings.sublabel != blank -%}
              <span class="tg-age__sub">{{ block.settings.sublabel | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Toggi shop by age",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by age"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The right toy for every stage of growing up"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFAF3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#135B33"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age group",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "0–12 M"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sub-label",
          "default": "Baby"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Uses the collection link if empty."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "baby", "label": "Baby" },
            { "value": "puzzle", "label": "Puzzle" },
            { "value": "star", "label": "Star" },
            { "value": "rocket", "label": "Rocket" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "baby"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Icon background (light tint)",
          "default": "#EFF7F1"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Accent color (icon + label)",
          "default": "#1A7F41"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Toggi shop by age",
      "blocks": [
        { "type": "age" },
        { "type": "age", "settings": { "label": "1–3 Y", "sublabel": "Toddler", "icon": "puzzle", "bg_color": "#FFF3EA", "text_color": "#C94F12" } },
        { "type": "age", "settings": { "label": "3–5 Y", "sublabel": "Preschool", "icon": "star", "bg_color": "#FFF8E8", "text_color": "#8A5A00" } },
        { "type": "age", "settings": { "label": "5–8 Y", "sublabel": "Big kids", "icon": "rocket", "bg_color": "#F2F8E6", "text_color": "#4E7A12" } },
        { "type": "age", "settings": { "label": "8+ Y", "sublabel": "Pre-teen", "icon": "gift", "bg_color": "#E6F0EA", "text_color": "#135B33" } }
      ]
    }
  ]
}
{% endschema %}
