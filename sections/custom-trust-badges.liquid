{%- comment -%}
  Toggi Toys — Trust badges (COD, delivery, returns, genuine products…)
  2x2 on mobile, one row on desktop.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .tg-section {
    --tg-bg: {{ section.settings.bg_color }};
    --tg-card-bg: {{ section.settings.card_color }};
    --tg-icon: {{ section.settings.icon_color }};
    --tg-icon-bg: {{ section.settings.icon_bg_color }};
    --tg-heading: {{ section.settings.heading_color }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="tg-section section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="tg-section__header tg-section__header--center">
        <h2 class="tg-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ul class="tg-trust" style="--tg-cols: {{ section.blocks.size | at_least: 1 }};" role="list">
      {%- for block in section.blocks -%}
        <li class="tg-trust__item" {{ block.shopify_attributes }}>
          <span class="tg-trust__icon">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {% render 'tg-icon', icon: block.settings.icon %}
            {%- endif -%}
          </span>
          <div>
            {%- if block.settings.title != blank -%}
              <h3 class="tg-trust__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="tg-trust__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Toggi trust badges",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why parents love Toggi"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#EFF7F1"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#1A7F41"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background",
      "default": "#EFF7F1"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#135B33"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cod", "label": "Cash on delivery" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "return", "label": "Return" },
            { "value": "shield", "label": "Genuine / shield" },
            { "value": "whatsapp", "label": "Chat / WhatsApp" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" }
          ],
          "default": "cod"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "Optional. Replaces the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cash on Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pay when your order arrives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Toggi trust badges",
      "blocks": [
        { "type": "badge" },
        { "type": "badge", "settings": { "icon": "truck", "title": "Fast Delivery", "text": "Shipping all over Bangladesh" } },
        { "type": "badge", "settings": { "icon": "return", "title": "Easy Return", "text": "Hassle-free returns & exchange" } },
        { "type": "badge", "settings": { "icon": "shield", "title": "Genuine Products", "text": "100% authentic, quality-checked toys" } }
      ]
    }
  ]
}
{% endschema %}
